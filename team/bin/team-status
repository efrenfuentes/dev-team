#!/usr/bin/env bash
# Status of every feature workspace under <repo>/.team/. Run from anywhere inside the repo.
#
#   team-status [--json] [--offline]
#
# Per feature: branch, base, plan rounds and verdict, code iterations and verdict, phase
# (planning | planned | developing | responding | approved | incomplete | merged | closed),
# unchecked tasks, items for a person, the worktree (its path, "-" for features without one,
# "(removed)" after team-clean) and the PR.
# For a feature with a PR (or a pushed branch), it asks GitHub (team-respond peek, in parallel)
# for the PR's state, its CI (passing | failing | pending | none) and how many comments nobody
# answered yet. --offline, or a missing or logged-out gh, skips that and shows the PR state last
# recorded in state.json. Works from the main checkout or from any of the repo's worktrees.
set -euo pipefail

# shellcheck source=/dev/null
. "$HOME/.claude/team/lib.sh"
repo=$(team_main_repo)
json="" offline=false
for a in "$@"; do
  case "$a" in --json) json=--json ;; --offline) offline=true ;; *) echo "unknown option: $a" >&2; exit 2 ;; esac
done
if [ "$offline" = false ] && ! { command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; }; then offline=true; fi

# Ask GitHub about every feature that has a PR or a pushed branch, all at once.
remote_refs=$(git -C "$repo" for-each-ref --format='%(refname)' refs/remotes 2>/dev/null || true)
peeks=$(mktemp -d)
trap 'rm -rf "$peeks"' EXIT
if [ "$offline" = false ]; then
  for dir in "$repo"/.team/[0-9][0-9][0-9]-*/; do
    dir=${dir%/}
    [ -f "$dir/state.json" ] || continue
    [ "$(jq -r '.pr.state // empty' "$dir/state.json")" != MERGED ] || continue
    branch=$(jq -r '.branch // empty' "$dir/state.json")
    if [ -n "$(jq -r '.pr.url // empty' "$dir/state.json")" ] ||
      { [ -n "$branch" ] && grep -qxF "$branch" <<<"$(sed -E 's#^refs/remotes/[^/]+/##' <<<"$remote_refs")"; }; then
      "$TEAM/bin/team-respond" "$dir" peek >"$peeks/$(basename "$dir").json" 2>/dev/null &
    fi
  done
  wait
fi

rows=()
for dir in "$repo"/.team/[0-9][0-9][0-9]-*/; do
  [ -d "$dir" ] || continue
  dir=${dir%/}
  state="$dir/state.json"
  [ -f "$state" ] || continue

  plan_n=$(find "$dir/reviews" -name 'plan-*.json' 2>/dev/null | wc -l | tr -d ' ')
  code_n=$(find "$dir/reviews" -name 'code-*.json' 2>/dev/null | wc -l | tr -d ' ')
  plan_v=$([ "$plan_n" -gt 0 ] && jq -r .verdict "$dir/reviews/plan-$plan_n.json" || echo "-")
  code_v=$([ "$code_n" -gt 0 ] && jq -r .verdict "$dir/reviews/code-$code_n.json" || echo "-")

  code_max=$(team_review_budget "$dir")
  respond_from=$(jq -r '.respond.pending.from_iter // empty' "$state")
  peek=$(jq -c 'select(.ok == true)' "$peeks/$(basename "$dir").json" 2>/dev/null || true)
  [ -n "$peek" ] || peek=null
  pr_state=$(jq -r '.pr.state // empty' "$state")
  if [ "$pr_state" = MERGED ]; then phase=merged
  elif [ "$pr_state" = CLOSED ]; then phase=closed
  elif [ -n "$respond_from" ] && [ "$code_n" -lt "$respond_from" ] && [ "$code_n" -lt "$code_max" ]; then phase=responding
  elif [ "$code_v" = APPROVED ]; then phase=approved
  elif [ "$code_n" -ge "$code_max" ]; then phase=incomplete
  elif [ "$code_n" -gt 0 ]; then phase=developing
  elif [ -s "$dir/tasks.md" ]; then phase=planned
  else phase=planning
  fi

  unchecked=$(grep -c '^- \[ \]' "$dir/tasks.md" 2>/dev/null || true)
  manual=$(awk '/^## Verificación manual/{f=1; next} /^## /{f=0} f && /^- /{n++} END{print n+0}' "$dir/tasks.md" 2>/dev/null || echo 0)
  # find, not a glob: with no reviews yet, `cat *.json` fails and `|| echo 0` printed a second 0.
  human=$(find "$dir/reviews" -name '*.json' -exec cat {} + 2>/dev/null |
    jq -s '[.[].findings[]? | select(.severity == "human")] | length' 2>/dev/null || true)

  wt=$(jq -r '.worktree // "-"' "$state")
  [ "$wt" = - ] || [ -d "$wt" ] || wt="$wt (removed)"

  rows+=("$(jq -n --arg id "$(basename "$dir")" --arg phase "$phase" --arg worktree "$wt" \
    --arg branch "$(jq -r '.branch // "-"' "$state")" --arg base "$(jq -r '.base_ref // "-"' "$state")" \
    --argjson plan_n "$plan_n" --arg plan_v "$plan_v" --argjson plan_max "$TEAM_MAX_PLAN_ROUNDS" \
    --argjson code_n "$code_n" --arg code_v "$code_v" --argjson code_max "$code_max" \
    --argjson unchecked "${unchecked:-0}" --argjson manual "$manual" --argjson human "${human:-0}" \
    --argjson final "$([ -f "$dir/final-report.md" ] && echo true || echo false)" \
    --argjson pr "$(jq '.pr.url // null' "$state")" --arg pr_state "$pr_state" --argjson peek "$peek" \
    '{id: $id, phase: $phase, branch: $branch, base: $base, worktree: $worktree,
      plan: {rounds: $plan_n, max: $plan_max, verdict: $plan_v},
      code: {iterations: $code_n, max: $code_max, verdict: $code_v},
      unchecked_tasks: $unchecked, manual_items: $manual, human_findings: $human, final_report: $final,
      pr: $pr, pr_state: (if $pr_state == "" then null else $pr_state end),
      ci: (if $peek then $peek.ci.state else null end),
      ci_failed: (if $peek then $peek.ci.failed else null end),
      ci_stale: (if $peek then $peek.ci.stale else null end),
      comments: (if $peek then $peek.comments else null end)}')")
done

all=$(printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -s .)
if [ "$json" = "--json" ]; then echo "$all"; exit 0; fi

if [ "$(echo "$all" | jq length)" -eq 0 ]; then echo "No features under $repo/.team"; exit 0; fi
{
  echo "FEATURE|FASE|RAMA|PLAN|CÓDIGO|TAREAS ABIERTAS|PARA PERSONA|PR|CI|COMENTARIOS"
  echo "$all" | jq -r '.[] | [
      .id, .phase, .branch,
      "\(.plan.rounds)/\(.plan.max) \(.plan.verdict)",
      "\(.code.iterations)/\(.code.max) \(.code.verdict)",
      (.unchecked_tasks | tostring),
      ((.manual_items + .human_findings) | tostring),
      (.pr // "-" | sub(".*/pull/"; "#")),
      ({passing: "ok", failing: "FALLA", pending: "corriendo", none: "sin checks"}[.ci // ""] // "-")
        + (if .ci_stale then " (viejo)" else "" end),
      (.comments // "-" | tostring)
    ] | join("|")'
} | column -t -s '|'
