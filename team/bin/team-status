#!/usr/bin/env bash
# Status of every feature workspace under <repo>/.team/. Run from anywhere inside the repo.
#
#   team-status [--json]
#
# Per feature: branch, base, plan rounds and verdict, code iterations and verdict, phase
# (planning | planned | developing | approved | incomplete), unchecked tasks, items for a person.
set -euo pipefail

# shellcheck source=/dev/null
. "$HOME/.claude/team/config.sh"
repo=$(git rev-parse --show-toplevel)
json=${1:-}

rows=()
for dir in "$repo"/.team/[0-9][0-9][0-9]-*/; do
  [ -d "$dir" ] || continue
  dir=${dir%/}
  state="$dir/state.json"
  [ -f "$state" ] || continue

  plan_n=$(find "$dir/reviews" -name 'plan-*.json' 2>/dev/null | wc -l | tr -d ' ')
  code_n=$(find "$dir/reviews" -name 'code-*.json' 2>/dev/null | wc -l | tr -d ' ')
  plan_v=$([ "$plan_n" -gt 0 ] && jq -r .verdict "$dir/reviews/plan-$plan_n.json" || echo "-")
  code_v=$([ "$code_n" -gt 0 ] && jq -r .verdict "$dir/reviews/code-$code_n.json" || echo "-")

  if [ "$code_v" = APPROVED ]; then phase=approved
  elif [ "$code_n" -ge "$TEAM_MAX_CODE_REVIEWS" ]; then phase=incomplete
  elif [ "$code_n" -gt 0 ]; then phase=developing
  elif [ -s "$dir/tasks.md" ]; then phase=planned
  else phase=planning
  fi

  unchecked=$(grep -c '^- \[ \]' "$dir/tasks.md" 2>/dev/null || true)
  manual=$(awk '/^## Verificación manual/{f=1; next} /^## /{f=0} f && /^- /{n++} END{print n+0}' "$dir/tasks.md" 2>/dev/null || echo 0)
  human=$(cat "$dir"/reviews/*.json 2>/dev/null | jq -s '[.[].findings[]? | select(.severity == "human")] | length' 2>/dev/null || echo 0)

  rows+=("$(jq -n --arg id "$(basename "$dir")" --arg phase "$phase" \
    --arg branch "$(jq -r '.branch // "-"' "$state")" --arg base "$(jq -r '.base_ref // "-"' "$state")" \
    --argjson plan_n "$plan_n" --arg plan_v "$plan_v" --argjson plan_max "$TEAM_MAX_PLAN_ROUNDS" \
    --argjson code_n "$code_n" --arg code_v "$code_v" --argjson code_max "$TEAM_MAX_CODE_REVIEWS" \
    --argjson unchecked "${unchecked:-0}" --argjson manual "$manual" --argjson human "$human" \
    --argjson final "$([ -f "$dir/final-report.md" ] && echo true || echo false)" \
    '{id: $id, phase: $phase, branch: $branch, base: $base,
      plan: {rounds: $plan_n, max: $plan_max, verdict: $plan_v},
      code: {iterations: $code_n, max: $code_max, verdict: $code_v},
      unchecked_tasks: $unchecked, manual_items: $manual, human_findings: $human, final_report: $final}')")
done

all=$(printf '%s\n' "${rows[@]+"${rows[@]}"}" | jq -s .)
if [ "$json" = "--json" ]; then echo "$all"; exit 0; fi

if [ "$(echo "$all" | jq length)" -eq 0 ]; then echo "No features under $repo/.team"; exit 0; fi
{
  echo "FEATURE|FASE|RAMA|PLAN|CÓDIGO|TAREAS ABIERTAS|PARA PERSONA"
  echo "$all" | jq -r '.[] | [
      .id, .phase, .branch,
      "\(.plan.rounds)/\(.plan.max) \(.plan.verdict)",
      "\(.code.iterations)/\(.code.max) \(.code.verdict)",
      (.unchecked_tasks | tostring),
      ((.manual_items + .human_findings) | tostring)
    ] | join("|")'
} | column -t -s '|'
