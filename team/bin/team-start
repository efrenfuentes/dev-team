#!/usr/bin/env bash
# Preflight before the dev loop. Prints JSON: {ok, feature_dir, worktree, base_sha, branch,
# start_iter, max_iter, finished, error?}
#
#   team-start <feature_dir> [--reset]
#
# Works in the feature's worktree (or the main checkout for features without one). If the
# worktree was removed (team-clean), it is recreated from the feature branch; if its setup
# failed or never ran, setup runs again first.
#
# Refuses to start on a dirty tree or on main/master/develop, because the Developer commits
# every iteration and must not sweep up unrelated work. base_sha is recorded once and kept
# on later runs (so an interrupted loop resumes), including with --reset: the reviewer must
# keep seeing the whole feature, not just what comes after the reset. It is the merge-base
# of HEAD and base_ref (so commits already on the branch are reviewed too), or HEAD when
# base_ref can't be resolved. --reset only restarts the iteration count.
set -euo pipefail

# shellcheck source=/dev/null
. "$HOME/.claude/team/lib.sh"
dir=$(cd "${1:?usage: team-start <feature_dir> [--reset]}" && pwd)
reset=${2:-}
state="$dir/state.json"

fail() { jq -n --arg e "$1" --arg d "$dir" '{ok: false, feature_dir: $d, error: $e}'; exit 1; }

[ -f "$state" ] || fail "missing state.json — run team-init first"
max=$(team_review_budget "$dir")
main=$(team_main_repo "$dir")
repo=$(team_worktree "$dir")
has_wt=$(jq -r 'has("worktree")' "$state")

if [ "$has_wt" = true ]; then
  if [ ! -d "$repo" ]; then
    wt_branch=$(jq -r '.branch // empty' "$state")
    [ -n "$wt_branch" ] && git -C "$main" show-ref --verify -q "refs/heads/$wt_branch" ||
      fail "worktree $repo is gone and branch '${wt_branch:-?}' does not exist"
    git -C "$main" worktree prune
    git -C "$main" worktree add --quiet "$repo" "$wt_branch" >&2 || fail "could not recreate the worktree at $repo"
    team_state_set "$dir" '.setup.ok = false | del(.worktree_removed)'
  fi
  if [ "$(jq -r '.setup.ok // false' "$state")" != true ]; then
    "$TEAM/bin/team-setup" "$dir" >/dev/null ||
      fail "worktree setup failed — see $dir/logs/setup.log, fix it and run ~/.claude/team/bin/team-setup $dir"
  fi
fi
cd "$repo"
[ -s "$dir/tasks.md" ] || fail "missing tasks.md — run /team-plan first"
[ -s "$dir/plan.md" ] || fail "missing plan.md — run /team-plan first"

branch=$(git branch --show-current)
case "$branch" in
  "" ) fail "detached HEAD — switch to a feature branch" ;;
  main | master | develop ) fail "on protected branch '$branch' — create a feature branch first" ;;
esac
if [ "$has_wt" = true ]; then
  want=$(jq -r '.branch // empty' "$state")
  [ "$branch" = "$want" ] || fail "the worktree $repo is on '$branch', not on the feature branch '$want' — switch it back"
fi

dirty=$(git status --porcelain --untracked-files=normal)
[ -z "$dirty" ] || fail "working tree is not clean — commit or stash first: $(echo "$dirty" | head -5 | tr '\n' ' ')"

# --reset archives the previous loop's outputs (reviews, gates, logs, reports, dev-log) under
# archive/reset-<timestamp>/ and strips the reviewer's correction sections from tasks.md, so the
# new Iteración 1 does not mix with the old one. Plan artifacts and the code stay as they are.
if [ "$reset" = "--reset" ]; then
  arch="$dir/archive/reset-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$arch"
  for f in reviews/code-*.json gates/iter-* logs/codex-code-* logs/codex-final-* review-report.md dev-log.md final-report.md; do
    for path in "$dir"/$f; do
      [ -e "$path" ] || continue
      mkdir -p "$arch/$(dirname "$f")"
      mv "$path" "$arch/$(dirname "$f")/"
    done
  done
  # Only the reviewer's sections: a person's PR comments (## Comentarios de la PR) stay as tasks.
  perl -0pi -e 's/\n*## Correcciones — revisión \d+\n.*?(?=\n## (?!Correcciones — revisión)|\z)/\n/sg; s/\n*\z/\n/' "$dir/tasks.md"
  team_state_set "$dir" 'del(.review_budget) | del(.respond.pending)'
  max=$TEAM_MAX_CODE_REVIEWS
fi

base_sha=$(jq -r '.base_sha // empty' "$state")
if [ -z "$base_sha" ]; then
  base_ref=$(jq -r '.base_ref // empty' "$state")
  base_sha=""
  [ -n "$base_ref" ] && base_sha=$(git merge-base HEAD "$base_ref" 2>/dev/null || true)
  [ -n "$base_sha" ] || base_sha=$(git rev-parse HEAD)
  jq --arg s "$base_sha" --arg b "$branch" '.base_sha = $s | .branch = $b' "$state" >"$state.tmp" && mv "$state.tmp" "$state"
fi

done_iters=$(find "$dir/reviews" -name 'code-*.json' | wc -l | tr -d ' ')
# An approved loop is finished, unless a /team-respond round added PR comments as tasks after
# that approval (respond.pending.from_iter is the first iteration of that round).
respond_from=$(jq -r '.respond.pending.from_iter // empty' "$state")
finished=false
if [ "$done_iters" -ge "$max" ]; then
  finished=true
elif [ "$done_iters" -gt 0 ] && [ "$(jq -r '.verdict' "$dir/reviews/code-$done_iters.json")" = "APPROVED" ] &&
  { [ -z "$respond_from" ] || [ "$done_iters" -ge "$respond_from" ]; }; then
  finished=true
fi
jq -n --arg d "$dir" --arg s "$base_sha" --arg b "$branch" --argjson i $((done_iters + 1)) --argjson f $finished \
  --argjson max "$max" \
  --arg wt "$repo" \
  '{ok: true, feature_dir: $d, worktree: $wt, base_sha: $s, branch: $b, start_iter: $i, max_iter: $max, finished: $f}'
