#!/usr/bin/env bash
# Create a new feature workspace under <repo>/.team/NNN-<slug>/ and print its absolute path.
#
#   team-init <slug> [base_ref]
#
# base_ref defaults to the remote's default branch (origin/HEAD), then the first of
# origin/develop, origin/main, origin/master that exists.
# .team/ is added to .git/info/exclude (local only), so it never shows up in commits.
set -euo pipefail

slug=${1:?usage: team-init <slug> [base_ref]}
base_ref=${2:-}

repo=$(git rev-parse --show-toplevel)

if [ -z "$base_ref" ]; then
  base_ref=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [ -z "$base_ref" ]; then
    for candidate in origin/develop origin/main origin/master; do
      git rev-parse --verify -q "$candidate" >/dev/null 2>&1 && { base_ref=$candidate; break; }
    done
  fi
  [ -n "$base_ref" ] || { echo "cannot detect a base branch; pass it: team-init $slug <base_ref>" >&2; exit 1; }
fi
exclude="$(git rev-parse --path-format=absolute --git-common-dir)/info/exclude"
mkdir -p "$(dirname "$exclude")"
grep -qxF '.team/' "$exclude" 2>/dev/null || echo '.team/' >>"$exclude"

mkdir -p "$repo/.team"
n=$(find "$repo/.team" -mindepth 1 -maxdepth 1 -type d -name '[0-9][0-9][0-9]-*' | wc -l | tr -d ' ')
dir="$repo/.team/$(printf '%03d' $((n + 1)))-$slug"
mkdir -p "$dir/reviews" "$dir/gates"

jq -n --arg slug "$slug" --arg base_ref "$base_ref" --arg created "$(date -u +%FT%TZ)" \
  '{feature: $slug, base_ref: $base_ref, created: $created, base_sha: null, branch: null}' \
  >"$dir/state.json"

echo "$dir"
