#!/usr/bin/env bash
# Run the repo's automatic gates (tests + lint) in the feature's worktree.
#
#   team-gates <feature_dir> <iter>   # the official run after an iteration → gates/iter-N.{log,json}
#                                     # (a rerun after a gate repair keeps the earlier run as
#                                     #  gates/iter-N-try-K.{log,json}; iter-N.* is always the latest)
#   team-gates <feature_dir>          # the Developer's own check before committing → gates/check.{log,json}
#                                     # (an official run on the very same tree reuses it instead of
#                                     #  running the suite twice; TEAM_GATES_REUSE=0 turns that off)
#   team-gates <feature_dir> --which  # which gate script would run, without running it
#
# Gate script lookup: <main>/.team/gates.sh (source "project"), then
# ~/.claude/team/gates/<repo-name>.sh ("repo"), then the default gates of the worktree's stack,
# gates/stacks/<stack>.sh ("stack"; TEAM_STACK_GATES=0 turns them off).
# The gate script runs from the worktree root with the feature env (BASE_SHA, BASE_REF,
# TEAM_PARTITION, MIX_TEST_PARTITION, ...) and must exit non-zero on failure. With
# TEAM_GATES_LOCK=1 or <main>/.team/serialize-gates, gates of the same repo run one at a time.
# Prints the JSON.
set -uo pipefail

# shellcheck source=/dev/null
. "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/team/lib.sh"

dir=$(cd "${1:?usage: team-gates <feature_dir> [iter | --which]}" && pwd)
iter=${2:-}
team_feature_env "$dir"
source="" script=""
read -r source script <<<"$(team_gates_script "$dir" || true)"

if [ "$iter" = --which ]; then
  jq -n --arg s "$script" --arg src "$source" --arg stack "$(team_stack "$TEAM_WORKTREE" || true)" '
    {configured: ($s != ""), script: (if $s == "" then null else $s end),
     source: (if $src == "" then null else $src end), stack: (if $stack == "" then null else $stack end)}'
  exit 0
fi
cd "$TEAM_WORKTREE" || exit 1

name=$([ -n "$iter" ] && echo "iter-$iter" || echo check)
log="$dir/gates/$name.log"
json="$dir/gates/$name.json"
mkdir -p "$dir/gates"
if [ -n "$iter" ] && [ -f "$json" ]; then
  k=$(find "$dir/gates" -name "iter-$iter-try-*.json" | wc -l | tr -d ' ')
  k=$((k + 1))
  mv "$json" "$dir/gates/iter-$iter-try-$k.json"
  [ -f "$log" ] && mv "$log" "$dir/gates/iter-$iter-try-$k.log"
fi

if [ -z "$script" ]; then
  echo "No gate script configured for $(team_repo_name "$dir"), and no default gates for its stack" >"$log"
  jq -n --arg log "$log" '{passed: true, configured: false, script: null, source: null, log: $log}' | tee "$json"
  exit 0
fi

# Hash of the tree the gates run on: the working tree as it would be committed (tracked and
# untracked files, ignored ones left out) for the Developer's check, so that the official run
# after the commit can tell whether it is looking at the very same code.
tree_hash() {
  local idx
  idx=$(mktemp)
  cp "$(git rev-parse --git-path index)" "$idx" 2>/dev/null || true
  GIT_INDEX_FILE=$idx git add -A . >/dev/null 2>&1 && GIT_INDEX_FILE=$idx git write-tree 2>/dev/null
  rm -f "$idx"
}
tree=$(tree_hash || true)

# An official run on exactly the tree the Developer already checked, with the same script, would
# run the same suite twice: reuse that check instead (TEAM_GATES_REUSE=0 always runs).
check="$dir/gates/check.json"
if [ -n "$iter" ] && [ "${TEAM_GATES_REUSE:-1}" = 1 ] && [ -f "$check" ] && [ -n "$tree" ] &&
  [ "$(jq -r --arg t "$tree" --arg s "$script" '(.passed == true and .configured == true and .tree == $t and .script == $s)' "$check")" = true ]; then
  { echo "== reused the Developer's own check of this same tree ($tree); its log follows"; echo; cat "$dir/gates/check.log" 2>/dev/null; } >"$log"
  jq --arg log "$log" '. + {log: $log, reused_check: true}' "$check" | tee "$json"
  exit 0
fi

if team_gates_serialized "$dir"; then
  lock="$(git rev-parse --path-format=absolute --git-common-dir)/team-gates.lock"
  echo "== waiting for the gates lock ($lock)" >"$log"
  team_with_lock "$lock" bash "$script" >>"$log" 2>&1
else
  bash "$script" >"$log" 2>&1
fi
code=$?
jq -n --argjson passed "$([ $code -eq 0 ] && echo true || echo false)" --arg script "$script" \
  --arg src "$source" --arg log "$log" --argjson code $code --arg tree "$tree" \
  '{passed: $passed, configured: true, script: $script, source: $src, exit_code: $code, log: $log,
    tree: (if $tree == "" then null else $tree end)}' | tee "$json"
