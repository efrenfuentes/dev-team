#!/usr/bin/env bash
# Run the repo's automatic gates (tests + lint) in the feature's worktree.
#
#   team-gates <feature_dir> <iter>   # the official run after an iteration → gates/iter-N.{log,json}
#   team-gates <feature_dir>          # the Developer's own check before committing → gates/check.{log,json}
#
# Gate script lookup: <main>/.team/gates.sh, then ~/.claude/team/gates/<repo-name>.sh.
# The gate script runs from the worktree root with the feature env (BASE_SHA, BASE_REF,
# TEAM_PARTITION, MIX_TEST_PARTITION, ...) and must exit non-zero on failure. With
# TEAM_GATES_LOCK=1 or <main>/.team/serialize-gates, gates of the same repo run one at a time.
# Prints the JSON.
set -uo pipefail

# shellcheck source=/dev/null
. "$HOME/.claude/team/lib.sh"

dir=$(cd "${1:?usage: team-gates <feature_dir> [iter]}" && pwd)
iter=${2:-}
team_feature_env "$dir"
cd "$TEAM_WORKTREE" || exit 1

name=$([ -n "$iter" ] && echo "iter-$iter" || echo check)
log="$dir/gates/$name.log"
json="$dir/gates/$name.json"
mkdir -p "$dir/gates"
script=$(team_project_script gates "$dir" || true)

if [ -z "$script" ]; then
  echo "No gate script configured for $(team_repo_name "$dir")" >"$log"
  jq -n --arg log "$log" '{passed: true, configured: false, script: null, log: $log}' | tee "$json"
  exit 0
fi

if team_gates_serialized "$dir"; then
  lock="$(git rev-parse --path-format=absolute --git-common-dir)/team-gates.lock"
  echo "== waiting for the gates lock ($lock)" >"$log"
  team_with_lock "$lock" bash "$script" >>"$log" 2>&1
else
  bash "$script" >"$log" 2>&1
fi
code=$?
jq -n --argjson passed "$([ $code -eq 0 ] && echo true || echo false)" --arg script "$script" \
  --arg log "$log" --argjson code $code \
  '{passed: $passed, configured: true, script: $script, exit_code: $code, log: $log}' | tee "$json"
